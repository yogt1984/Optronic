{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "OPTRONIC_WERROR": "ON"
      }
    },
    {
      "name": "host-debug",
      "inherits": "base",
      "displayName": "Host, Debug, tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OPTRONIC_BUILD_TESTS": "ON" }
    },
    {
      "name": "host-release",
      "inherits": "base",
      "displayName": "Host, RelWithDebInfo, tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "OPTRONIC_BUILD_TESTS": "ON" }
    },
    {
      "name": "host-asan",
      "inherits": "host-debug",
      "displayName": "Host, Debug, ASan+UBSan",
      "cacheVariables": { "OPTRONIC_SANITIZER": "address,undefined" }
    },
    {
      "name": "host-tsan",
      "inherits": "host-debug",
      "displayName": "Host, Debug, TSan",
      "cacheVariables": { "OPTRONIC_SANITIZER": "thread" }
    },
    {
      "name": "arm64-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchain-aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "OPTRONIC_BUILD_TESTS": "ON",
        "OPTRONIC_LTO": "ON"
      }
    },
    {
      "name": "arm64-petalinux",
      "inherits": "arm64-base",
      "displayName": "aarch64 via PetaLinux/Yocto SDK (source environment-setup first)",
      "condition": { "type": "notEquals", "lhs": "$env{OECORE_TARGET_SYSROOT}", "rhs": "" }
    },
    {
      "name": "arm64-debian",
      "inherits": "arm64-base",
      "displayName": "aarch64 via crossbuild-essential-arm64 (fallback)"
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "host-tsan", "configurePreset": "host-tsan" },
    { "name": "arm64-petalinux", "configurePreset": "arm64-petalinux" },
    { "name": "arm64-debian", "configurePreset": "arm64-debian" }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "ignore", "stopOnFailure": false }
    },
    { "name": "host-debug", "inherits": "base-test", "configurePreset": "host-debug" },
    { "name": "host-release", "inherits": "base-test", "configurePreset": "host-release" },
    { "name": "host-asan", "inherits": "base-test", "configurePreset": "host-asan" },
    { "name": "host-tsan", "inherits": "base-test", "configurePreset": "host-tsan" },
    {
      "name": "arm64-qemu",
      "inherits": "base-test",
      "configurePreset": "arm64-petalinux",
      "description": "Runs the cross-built suite in PetaLinux QEMU (wired up later)"
    }
  ],
  "workflowPresets": [
    {
      "name": "host-debug",
      "steps": [
        { "type": "configure", "name": "host-debug" },
        { "type": "build", "name": "host-debug" },
        { "type": "test", "name": "host-debug" }
      ]
    }
  ]
}
