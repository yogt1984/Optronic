# syntax=docker/dockerfile:1
# PetaLinux tools image - base for BSP builds and for producing the SDK.
#
# The PetaLinux installer is licensed and not redistributable, so it is not
# part of this repository. Download petalinux-v<VER>-final-installer.run from
# AMD and pass it as a build secret:
#
#   docker build -f docker/Dockerfile.petalinux -t optronic/plnx:2024.1 \
#     --build-arg PLNX_VERSION=2024.1 \
#     --secret id=plnx,src=$HOME/Downloads/petalinux-v2024.1-final-installer.run .
#
# Host requirements follow UG1144 for the chosen release. Ubuntu 22.04 is on
# the supported list for 2023.2 and 2024.1.

FROM ubuntu:22.04

ARG PLNX_VERSION=2024.1
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-lc"]

RUN dpkg --add-architecture i386 \
 && apt-get update && apt-get install -y --no-install-recommends \
      locales sudo ca-certificates curl wget git rsync cpio bc file \
      gawk gcc g++ make net-tools libncurses5-dev tftpd zlib1g-dev zlib1g:i386 \
      libssl-dev flex bison libselinux1 gnupg diffstat chrpath socat xterm \
      autoconf libtool tar unzip texinfo gcc-multilib build-essential \
      screen pax gzip python3 python3-pip python3-pexpect python3-git \
      python3-jinja2 xz-utils debianutils iputils-ping libegl1-mesa libsdl1.2-dev \
      pylint xvfb libtinfo5 lz4 zstd \
 && rm -rf /var/lib/apt/lists/* \
 && locale-gen en_US.UTF-8

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# PetaLinux refuses to run as root.
RUN userdel -r ubuntu 2>/dev/null || true \
 && useradd -m -u 1000 -s /bin/bash dev \
 && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev \
 && mkdir -p /opt/petalinux /sstate /downloads /work \
 && chown dev:dev /opt/petalinux /sstate /downloads /work
USER dev

RUN --mount=type=secret,id=plnx,uid=1000,target=/tmp/plnx.run \
    chmod +x /tmp/plnx.run \
 && /tmp/plnx.run -y -d /opt/petalinux --log /tmp/plnx-install.log \
 && rm -rf /opt/petalinux/*/tools/xsct/.installer 2>/dev/null || true

ENV PETALINUX=/opt/petalinux \
    PLNX_VERSION=${PLNX_VERSION} \
    SSTATE_DIR=/sstate \
    DL_DIR=/downloads

VOLUME ["/sstate", "/downloads", "/work"]
WORKDIR /work

# Every shell gets the PetaLinux environment.
RUN echo 'source $PETALINUX/settings.sh >/dev/null' >> ~/.bashrc
ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["petalinux-util --help | head -3"]
